# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
VITE_STRIPE_MONTHLY_PRICE_ID=your_stripe_monthly_price_id
VITE_STRIPE_YEARLY_PRICE_ID=your_stripe_yearly_price_id

# Google Gemini API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key

# Application Configuration
VITE_APP_URL=https://ghostscribe.xyz
NODE_ENV=production

# URLs
VITE_API_URL=http://localhost:3000 

# Note: Add these environment variables in your Vercel project settings
# Make sure to add all VITE_ prefixed variables to the client-side configuration 